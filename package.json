{
  "name": "imaguncula",
  "version": "1.0.0-beta.2",
  "description": "Offline desktop icon asset generator",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "wdio run e2e/wdio.conf.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri"
  },
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20 <26",
    "pnpm": ">=10 <12"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2"
  },
  "devDependencies": {
    "@axe-core/webdriverio": "4.14.0",
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "~2.11.4",
    "@testing-library/svelte": "5.4.2",
    "@vitest/coverage-v8": "4.1.12",
    "@wdio/cli": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "~5.6.3",
    "typescript-eslint": "8.73.0",
    "vite": "^6.4.6",
    "vitest": "4.1.12"
  }
}
