{
  "schemaVersion": 1,
  "id": "windows-desktop",
  "version": 1,
  "displayName": "Windows desktop (.ico)",
  "description": "A Win32 desktop icon containing Microsoft's minimum recommended Windows icon sizes.",
  "platform": "windows",
  "lastReviewed": "2026-07-31",
  "specSources": [
    "https://learn.microsoft.com/en-us/windows/apps/design/iconography/app-icon-construction"
  ],
  "sourceRoles": [
    {
      "role": "master",
      "required": true,
      "description": "The original square icon artwork used to render every ICO entry independently."
    }
  ],
  "outputs": [
    {
      "id": "icon-16",
      "sourceRole": "master",
      "format": "png",
      "width": 16,
      "height": 16,
      "usage": "Context menus, title bars, and the system tray at 100% scale.",
      "encoder": {
        "type": "png",
        "compression": "best",
        "filter": "adaptive"
      }
    },
    {
      "id": "icon-24",
      "sourceRole": "master",
      "format": "png",
      "width": 24,
      "height": 24,
      "usage": "Taskbar, search results, and the Start all-apps list at 100% scale.",
