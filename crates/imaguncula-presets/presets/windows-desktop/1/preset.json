  "validationRules": [
    {
      "rule": "square-source",
      "severity": "error",
      "sourceRole": "master"
    },
    {
      "rule": "no-upscale",
      "severity": "error",
      "sourceRole": "master"
    },
    {
      "rule": "minimum-source-size",
      "severity": "warning",
      "sourceRole": "master",
      "width": 256,
      "height": 256
    }
  ],
  "optionalOutputGroups": []
