        { "output": "android-background-mdpi", "path": "mipmap-mdpi/ic_launcher_background.png" },
        { "output": "android-background-hdpi", "path": "mipmap-hdpi/ic_launcher_background.png" },
        { "output": "android-background-xhdpi", "path": "mipmap-xhdpi/ic_launcher_background.png" },
        {
