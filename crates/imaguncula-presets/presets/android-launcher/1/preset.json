      "sourceRole": "monochrome",
      "format": "png",
      "width": 432,
      "height": 432,
      "usage": "Optional themed monochrome layer at xxxhdpi.",
      "encoder": { "type": "png", "compression": "best", "filter": "adaptive" }
    },

    {
      "id": "android-play-store-512",
      "sourceRole": "master",
      "format": "png",
      "width": 512,
      "height": 512,
      "maximumBytes": 1048576,
      "usage": "Opaque final Google Play Store listing artwork.",
      "encoder": {
        "type": "png",
        "compression": "best",
        "filter": "adaptive",
        "flattenColor": { "red": 255, "green": 255, "blue": 255 }
      }
    }
  ],
  "packages": [
    {
      "kind": "directory",
      "id": "android-res",
      "root": "res",
      "files": [
        { "output": "android-legacy-mdpi", "path": "mipmap-mdpi/ic_launcher.png" },
        { "output": "android-legacy-hdpi", "path": "mipmap-hdpi/ic_launcher.png" },
        { "output": "android-legacy-xhdpi", "path": "mipmap-xhdpi/ic_launcher.png" },
        { "output": "android-legacy-xxhdpi", "path": "mipmap-xxhdpi/ic_launcher.png" },
        { "output": "android-legacy-xxxhdpi", "path": "mipmap-xxxhdpi/ic_launcher.png" },
        { "output": "android-round-mdpi", "path": "mipmap-mdpi/ic_launcher_round.png" },
        { "output": "android-round-hdpi", "path": "mipmap-hdpi/ic_launcher_round.png" },
        { "output": "android-round-xhdpi", "path": "mipmap-xhdpi/ic_launcher_round.png" },
        { "output": "android-round-xxhdpi", "path": "mipmap-xxhdpi/ic_launcher_round.png" },
        { "output": "android-round-xxxhdpi", "path": "mipmap-xxxhdpi/ic_launcher_round.png" },
        { "output": "android-foreground-mdpi", "path": "mipmap-mdpi/ic_launcher_foreground.png" },
        { "output": "android-foreground-hdpi", "path": "mipmap-hdpi/ic_launcher_foreground.png" },
