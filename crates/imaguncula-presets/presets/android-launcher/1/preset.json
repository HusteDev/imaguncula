    {
      "kind": "metadata",
      "id": "android-adaptive-standard",
      "format": "xml",
      "path": "res/mipmap-anydpi-v26/ic_launcher.xml",
      "template": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<adaptive-icon xmlns:android=\"http://schemas.android.com/apk/res/android\">\n  <background android:drawable=\"@mipmap/{{background}}\" />\n  <foreground android:drawable=\"@mipmap/{{foreground}}\" />\n</adaptive-icon>\n",
      "references": [
        {
          "name": "background",
          "package": "android-res",
          "output": "android-background-xxxhdpi",
          "value": "resource-name"
        },
        {
          "name": "foreground",
          "package": "android-res",
          "output": "android-foreground-xxxhdpi",
          "value": "resource-name"
        }
      ],
      "requiresOutputs": [
        "android-foreground-mdpi",
        "android-foreground-hdpi",
        "android-foreground-xhdpi",
        "android-foreground-xxhdpi",
        "android-foreground-xxxhdpi",
        "android-background-mdpi",
        "android-background-hdpi",
        "android-background-xhdpi",
        "android-background-xxhdpi",
        "android-background-xxxhdpi"
      ]
    },
    {
      "kind": "metadata",
      "id": "android-adaptive-themed",
      "format": "xml",
      "path": "res/mipmap-anydpi-v33/ic_launcher.xml",
      "template": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<adaptive-icon xmlns:android=\"http://schemas.android.com/apk/res/android\">\n  <background android:drawable=\"@mipmap/{{background}}\" />\n  <foreground android:drawable=\"@mipmap/{{foreground}}\" />\n  <monochrome android:drawable=\"@mipmap/{{monochrome}}\" />\n</adaptive-icon>\n",
      "references": [
        {
          "name": "background",
          "package": "android-res",
          "output": "android-background-xxxhdpi",
          "value": "resource-name"
        },
        {
          "name": "foreground",
          "package": "android-res",
          "output": "android-foreground-xxxhdpi",
          "value": "resource-name"
        },
        {
          "name": "monochrome",
          "package": "android-res",
          "output": "android-monochrome-xxxhdpi",
          "value": "resource-name"
        }
      ],
      "requiresOutputs": [
        "android-monochrome-mdpi",
        "android-monochrome-hdpi",
        "android-monochrome-xhdpi",
        "android-monochrome-xxhdpi",
        "android-monochrome-xxxhdpi"
      ]
    }
  ],
  "validationRules": [
    { "rule": "square-source", "severity": "error", "sourceRole": "master" },
    { "rule": "square-source", "severity": "error", "sourceRole": "foreground" },
    { "rule": "square-source", "severity": "error", "sourceRole": "background" },
    { "rule": "square-source", "severity": "error", "sourceRole": "monochrome" },
    { "rule": "no-upscale", "severity": "error", "sourceRole": "master" },
    { "rule": "no-upscale", "severity": "error", "sourceRole": "foreground" },
    { "rule": "no-upscale", "severity": "error", "sourceRole": "background" },
    { "rule": "no-upscale", "severity": "error", "sourceRole": "monochrome" },
    {
      "rule": "minimum-source-size",
      "severity": "error",
      "sourceRole": "master",
      "width": 512,
      "height": 512
    },
    {
      "rule": "minimum-source-size",
      "severity": "error",
      "sourceRole": "foreground",
      "width": 432,
      "height": 432
    },
    {
      "rule": "minimum-source-size",
      "severity": "error",
      "sourceRole": "background",
      "width": 432,
      "height": 432
    },
    {
      "rule": "minimum-source-size",
      "severity": "error",
      "sourceRole": "monochrome",
      "width": 432,
      "height": 432
    },
    {
      "rule": "maskable-safe-zone",
      "severity": "warning",
      "outputs": [
        "android-foreground-mdpi",
        "android-foreground-hdpi",
        "android-foreground-xhdpi",
        "android-foreground-xxhdpi",
        "android-foreground-xxxhdpi",
        "android-monochrome-mdpi",
        "android-monochrome-hdpi",
        "android-monochrome-xhdpi",
        "android-monochrome-xxhdpi",
        "android-monochrome-xxxhdpi"
      ],
      "minimumSafeZonePercent": 61.111111
    }
  ],
  "optionalOutputGroups": [
    {
      "id": "round-launcher",
      "displayName": "Round launcher fallbacks",
      "description": "Add legacy round launcher PNGs for manifests that declare android:roundIcon.",
      "defaultEnabled": false,
      "outputs": [
        "android-round-mdpi",
        "android-round-hdpi",
        "android-round-xhdpi",
        "android-round-xxhdpi",
        "android-round-xxxhdpi"
      ]
    },
    {
      "id": "themed-monochrome",
      "displayName": "Android themed icon",
      "description": "Add monochrome resources and the API 33 adaptive-icon override.",
      "defaultEnabled": false,
      "outputs": [
        "android-monochrome-mdpi",
        "android-monochrome-hdpi",
        "android-monochrome-xhdpi",
        "android-monochrome-xxhdpi",
        "android-monochrome-xxxhdpi"
      ],
      "packages": ["android-adaptive-themed"]
    }
  ]
}
