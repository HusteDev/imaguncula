{
  "schemaVersion": 1,
  "id": "android-launcher",
  "version": 1,
  "displayName": "Android launcher and Play Store",
  "description": "Legacy density icons, optional round variants, adaptive foreground/background resources, optional monochrome resources, and flattened Play Store artwork.",
  "platform": "android",
  "lastReviewed": "2026-07-31",
  "specSources": [
    "https://developer.android.com/studio/write/create-app-icons",
    "https://developer.android.com/develop/ui/compose/system/icon_design_adaptive",
    "https://support.google.com/googleplay/android-developer/answer/9866151"
  ],
  "sourceRoles": [
    {
      "role": "master",
      "required": true,
      "description": "Flat square artwork for legacy launcher and Play Store outputs."
    },
    {
      "role": "foreground",
      "required": true,
      "description": "Adaptive foreground artwork laid out in a square 108-dp canvas."
    },
    {
      "role": "background",
      "required": true,
      "description": "Adaptive full-bleed background artwork."
    },
    {
      "role": "monochrome",
      "required": false,
      "description": "Optional single-color themed-icon artwork in a square 108-dp canvas."
    }
  ],
  "outputs": [
    {
      "id": "android-legacy-mdpi",
      "sourceRole": "master",
      "format": "png",
      "width": 48,
      "height": 48,
      "usage": "Legacy launcher icon at mdpi.",
      "encoder": { "type": "png", "compression": "best", "filter": "adaptive" }
    },
    {
      "id": "android-legacy-hdpi",
      "sourceRole": "master",
      "format": "png",
      "width": 72,
      "height": 72,
      "usage": "Legacy launcher icon at hdpi.",
      "encoder": { "type": "png", "compression": "best", "filter": "adaptive" }
    },
    {
      "id": "android-legacy-xhdpi",
      "sourceRole": "master",
      "format": "png",
      "width": 96,
      "height": 96,
      "usage": "Legacy launcher icon at xhdpi.",
      "encoder": { "type": "png", "compression": "best", "filter": "adaptive" }
    },
    {
      "id": "android-legacy-xxhdpi",
