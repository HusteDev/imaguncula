{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:imaguncula:schema:preset:1",
  "title": "Imaguncula preset",
  "description": "A versioned, data-driven icon export preset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "displayName",
    "platform",
    "lastReviewed",
    "specSources",
    "sourceRoles",
    "outputs",
    "packages",
    "validationRules",
    "optionalOutputGroups"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "exclusiveGroup": {
      "$ref": "#/$defs/id"
    },
    "platform": {
      "enum": ["windows", "web", "linux", "macos", "ios", "ipados", "android", "custom"]
    },
    "lastReviewed": {
      "type": "string",
      "format": "date"
    },
    "specSources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "sourceRoles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRole"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/filesPackage"
          },
          {
            "$ref": "#/$defs/containerPackage"
          },
          {
            "$ref": "#/$defs/directoryPackage"
          },
          {
            "$ref": "#/$defs/metadataPackage"
          }
        ]
      }
    },
    "validationRules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/sourceValidationRule"
          },
          {
            "$ref": "#/$defs/minimumSizeRule"
          },
          {
            "$ref": "#/$defs/maskableSafeZoneRule"
          }
        ]
      }
    },
    "optionalOutputGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/optionalOutputGroup"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^(?:[A-Za-z0-9._@-]|\\{base\\})+(?:/(?:[A-Za-z0-9._@-]|\\{base\\})+)*$",
      "not": {
        "pattern": "(?:^|/)\\.\\.(?:/|$)"
      }
    },
    "sourceRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "required", "description"],
      "properties": {
        "role": {
          "$ref": "#/$defs/id"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceRole", "format", "usage", "encoder"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sourceRole": {
          "$ref": "#/$defs/id"
        },
        "renamedFrom": {
          "$ref": "#/$defs/id"
        },
        "format": {
          "enum": ["png", "svg"]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "usage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "encoder": {
          "oneOf": [
            {
              "$ref": "#/$defs/pngEncoder"
            },
            {
              "$ref": "#/$defs/svgEncoder"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "png"
              }
            }
          },
          "then": {
            "required": ["width", "height"],
            "properties": {
              "encoder": {
                "$ref": "#/$defs/pngEncoder"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "svg"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["width"]
                },
                {
                  "required": ["height"]
                }
              ]
            },
            "properties": {
              "encoder": {
                "$ref": "#/$defs/svgEncoder"
              }
            }
          }
        }
      ]
    },
    "pngEncoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "compression", "filter"],
      "properties": {
        "type": {
          "const": "png"
        },
        "compression": {
          "enum": ["fast", "default", "best"]
        },
        "filter": {
          "enum": ["adaptive", "none", "sub", "up", "average", "paeth"]
        },
        "flattenColor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["red", "green", "blue"],
          "properties": {
            "red": { "type": "integer", "minimum": 0, "maximum": 255 },
            "green": { "type": "integer", "minimum": 0, "maximum": 255 },
            "blue": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        }
      }
    },
    "svgEncoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mode"],
      "properties": {
        "type": {
          "const": "svg"
        },
        "mode": {
          "const": "sanitized-source"
        }
      }
    },
    "packagedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "path"],
      "properties": {
        "output": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "filesPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "files"],
      "properties": {
        "kind": {
          "const": "files"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/packagedFile"
          }
        }
      }
    },
    "containerPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "format", "path", "entries"],
      "properties": {
        "kind": {
          "const": "container"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "format": {
          "enum": ["ico", "icns"]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["output", "encoding"],
            "properties": {
              "output": {
                "$ref": "#/$defs/id"
              },
              "encoding": {
                "enum": ["bmp", "png", "argb"]
              }
            }
          }
        }
      }
    },
    "directoryPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "root", "files"],
      "properties": {
        "kind": {
          "const": "directory"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "root": {
          "$ref": "#/$defs/relativePath"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/packagedFile"
          }
        }
      }
    },
    "metadataReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "package", "output"],
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "package": {
          "$ref": "#/$defs/id"
        },
        "output": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "enum": ["relative-path", "resource-name"]
        }
      }
    },
    "metadataPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "format", "path", "template", "references"],
      "properties": {
        "kind": {
          "const": "metadata"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "format": {
          "enum": ["json", "xml", "html", "text"]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metadataReference"
          }
        },
        "requiresOutputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "excludesOutputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "ruleSeverity": {
      "enum": ["error", "warning"]
    },
    "sourceValidationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "severity", "sourceRole"],
      "properties": {
        "rule": {
          "enum": ["square-source", "no-upscale"]
        },
        "severity": {
          "$ref": "#/$defs/ruleSeverity"
        },
        "sourceRole": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "minimumSizeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "severity", "sourceRole", "width", "height"],
      "properties": {
        "rule": {
          "const": "minimum-source-size"
        },
        "severity": {
          "$ref": "#/$defs/ruleSeverity"
        },
        "sourceRole": {
          "$ref": "#/$defs/id"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      }
    },
    "maskableSafeZoneRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "severity", "outputs", "minimumSafeZonePercent"],
      "properties": {
        "rule": {
          "const": "maskable-safe-zone"
        },
        "severity": {
          "$ref": "#/$defs/ruleSeverity"
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "minimumSafeZonePercent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      }
    },
    "optionalOutputGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "description", "defaultEnabled"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "defaultEnabled": {
          "type": "boolean"
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "anyOf": [
        {
          "required": ["outputs"]
        },
        {
          "required": ["packages"]
        }
      ]
    }
  }
}
